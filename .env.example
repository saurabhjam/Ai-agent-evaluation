# --- Judge model (Gemini free tier) ---


# --- Simulated user model (Groq) ---

# --- Simulated user model (Ollama, local) ---

# --- Simulated user model (Groq) ---
GCP_API_KEY=your_gcp_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# --- Judge model (Gemini free tier) ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# --- Chatbot under test ---
# The HTTP endpoint of the chatbot you're evaluating is now configured
# in the scenario YAML files (e.g. scenarios/real_company_chat.yaml).

# --- Storage ---

DB_PATH=./eval_results.db
# Management reporting includes only evaluations created at or after this UTC boundary.
MANAGEMENT_BASELINE_AT=2026-10-21T11:00:22Z

# Optional calling-only masked turn diagnostics (in-memory evaluation logs).
CALLING_DIAGNOSTICS_ENABLED=true
CALLING_DIAGNOSTICS_ENCRYPTED_TEXT=false
# Set only for a controlled diagnostic session; keep the Fernet key private.
CALLING_DIAGNOSTICS_ENCRYPTION_KEY=

# --- Run limits (backend validation defaults) ---
MAX_TURNS_PER_RUN=12
MIN_TURNS_PER_RUN=2
